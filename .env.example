# ==================== DISCORD ====================
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
# URL для OAuth2 callback (должен совпадать с настройками в Discord Developer Portal)
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# ==================== DATABASE ====================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/discord_bot
# Для Alembic (синхронный драйвер)
ALEMBIC_DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_bot

# ==================== WEB PANEL ====================
# Секретный ключ для сессий (минимум 32 символа)
SECRET_KEY=change_this_to_a_very_long_random_secret_key_32chars
# Адрес и порт веб-панели
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ==================== REDIS (опционально, для pub/sub) ====================
REDIS_URL=redis://localhost:6379/0

# ==================== GUILD ====================
# ID вашего Discord-сервера (гильдии)
GUILD_ID=your_guild_id_here

# ==================== LOGGING ====================
LOG_LEVEL=INFO
