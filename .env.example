# ==================== DISCORD ====================
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Хост веб-панели (например: https://mod.ovrdose.bothost.tech)
PANEL_BASE_URL=https://mod.ovrdose.bothost.tech
# URL для OAuth2 callback (добавьте его в Discord Developer Portal -> OAuth2 -> Redirects)
DISCORD_REDIRECT_URI=https://mod.ovrdose.bothost.tech/auth/callback

# ==================== GUILD & OWNERS ====================
GUILD_ID=1558606862277017690
STAFF_GUILD_ID=1558608015148716062
OWNER_IDS=410432175373156352
ROOT_PANEL_URL=https://ovrdose.bothost.tech

# ==================== DATABASE (ОБЩАЯ С ROOT) ====================
# Общая SQLite база данных Root (shared.db в WAL-режиме):
DATABASE_URL=sqlite+aiosqlite:///../Root ovrdose/root-core/data/shared.db
ALEMBIC_DATABASE_URL=sqlite:///../Root ovrdose/root-core/data/shared.db

# Или отдельный PostgreSQL (если требуется):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/discord_bot
# ALEMBIC_DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_bot

# ==================== WEB PANEL ====================
SECRET_KEY=change_this_to_a_very_long_random_secret_key_32chars
WEB_HOST=0.0.0.0
WEB_PORT=8000

# ==================== LOGGING ====================
LOG_LEVEL=INFO
